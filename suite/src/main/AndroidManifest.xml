<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:name=".YSuiteApp"
        android:allowBackup="false"
        android:label="YSuite"
        android:supportsRtl="true"
        android:theme="@style/Theme.YSuite">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Standalone feature APKs keep these services. Inside YSuite they are replaced by one
             shared service so the user grants Accessibility only once. -->
        <service
            android:name="com.yagay.YFloat.LensAccessibilityService"
            tools:node="remove" />
        <service
            android:name="com.yagay.YNotify.collector.UiAccessibilityService"
            tools:node="remove" />

        <service
            android:name=".accessibility.SuiteAccessibilityService"
            android:label="@string/suite_accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/suite_accessibility_service_config" />
        </service>
    </application>
</manifest>
