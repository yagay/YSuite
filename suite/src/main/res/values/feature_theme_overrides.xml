<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        App resources override library resources in the merged YSuite APK. These aliases make the
        ordinary entry Activities use one host theme without changing the independently buildable
        feature APKs. Special transparent/overlay YFloat themes are intentionally not overridden.
    -->
    <style name="Theme.YEntryCleaner" parent="Theme.YSuite" />
    <style name="Theme.YMiniGuard" parent="Theme.YSuite" />
    <style name="Theme.YNFC" parent="Theme.YSuite" />
    <style name="Theme.YParam" parent="Theme.YSuite" />
    <style name="Theme.YTaskManager" parent="Theme.YSuite" />
</resources>
