<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Shared host theme for all feature Activities inside YSuite.
        Material3 inherits the AppCompat theme contract, so classic AppCompatActivity,
        Material Views and Compose ComponentActivity screens can coexist in one host APK.
    -->
    <style name="Theme.YSuite" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
    </style>
</resources>
