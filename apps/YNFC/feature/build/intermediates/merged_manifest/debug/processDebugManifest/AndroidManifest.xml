<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yagay.YNFC" >

    <uses-sdk android:minSdkVersion="31" />

    <uses-permission android:name="android.permission.NFC" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application>
        <activity
            android:name="com.yagay.YNFC.MainActivity"
            android:theme="@style/Theme.YNFC" />

        <provider
            android:name="com.yagay.YNFC.ConfigProvider"
            android:authorities="com.yagay.YSuite.ynfc.config"
            android:directBootAware="true"
            android:exported="true" />
    </application>

</manifest>