<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
        </intent>
        <package android:name="com.google.android.apps.nbu.files" />
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.mi.android.globalFileexplorer" />
        <package android:name="com.mi.android.fileexplorer" />
        <package android:name="org.telegram.messenger" />
        <package android:name="com.whatsapp" />
        <package android:name="com.discord" />
        <package android:name="com.reddit.frontpage" />
    </queries>

    <application>
        <activity android:name="com.yagay.ydownload.MainActivity" android:exported="false" android:theme="@style/Theme.YUI" />
        <service android:name="com.yagay.ydownload.DownloadService" android:exported="false" android:foregroundServiceType="dataSync" />
    </application>
</manifest>
