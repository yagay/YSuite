<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="transparent">#00000000</color>
    <item name="yfloat_text_selection_controller" type="id"/>
    <string name="yfloat_accessibility_desc">用于 YFloat 的 View 识别、系统手势和由用户主动触发的无障碍截图。YSuite 中请确认开启的是 YFloat，而不是 YNotify 的无障碍服务。</string>
    <string name="yfloat_accessibility_service_label">YFloat 文字识别与系统操作</string>
    <style name="Theme.YFloat" parent="Theme.YUI"/>
    <style name="Theme.YFloat.ResultDialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="Theme.YFloat.ResultText" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="Theme.YFloat.ShadeDismiss" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
        <item name="android:colorAccent">@android:color/transparent</item>
    </style>
</resources>