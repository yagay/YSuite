<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:title="@string/ynotify_app_name" app:titleCentered="false" />

    <LinearLayout
        android:id="@+id/capture_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/yui_screen_horizontal"
        android:paddingVertical="@dimen/yui_control_gap">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_notification_access" style="@style/Widget.YUI.Button.Tonal"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ynotify_notification_access" android:textSize="12sp" />
        <Space android:layout_width="@dimen/yui_control_gap" android:layout_height="1dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_accessibility" style="@style/Widget.YUI.Button.Tonal"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="@string/ynotify_ui_messages" android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_box" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/yui_screen_horizontal"
        android:hint="@string/ynotify_search_timeline"
        style="@style/Widget.YUI.TextInput">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_edit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:id="@+id/filter_scroll" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/yui_screen_horizontal"
            android:paddingVertical="@dimen/yui_control_gap"
            app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/chip_all" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_filter_all" android:checked="true" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_notification" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_filter_notification" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_heads_up" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_filter_heads_up" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_bubble" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_filter_bubble" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_full_screen" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_filter_full_screen" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_toast" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_filter_toast" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_dialog" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_filter_dialog" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_popup" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_filter_popup" />
            <com.google.android.material.chip.Chip android:id="@+id/chip_snackbar" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_filter_snackbar" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:clipToPadding="false"
        android:paddingBottom="@dimen/yui_section_gap" />

    <ScrollView
        android:id="@+id/settings_panel" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:visibility="gone" android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/yui_screen_horizontal"
            android:paddingVertical="@dimen/yui_screen_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/ynotify_runtime_status" android:textAppearance="@style/TextAppearance.YUI.SectionTitle" />
            <TextView android:id="@+id/runtime_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textIsSelectable="true"
                android:textAppearance="@style/TextAppearance.YUI.Body" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/yui_section_gap"
                android:text="@string/ynotify_diagnostic_logs" android:textAppearance="@style/TextAppearance.YUI.SectionTitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="@string/ynotify_diagnostic_logs_desc"
                android:textAppearance="@style/TextAppearance.YUI.Body" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_export_diagnostics" style="@style/Widget.YUI.Button.Tonal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/yui_control_gap"
                android:text="@string/ynotify_export_diagnostics" />
            <TextView android:id="@+id/diagnostics_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/ynotify_diagnostics_location"
                android:textAppearance="@style/TextAppearance.YUI.Caption" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/yui_section_gap"
                android:text="@string/ynotify_history_repair" android:textAppearance="@style/TextAppearance.YUI.SectionTitle" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:text="@string/ynotify_history_repair_desc"
                android:textAppearance="@style/TextAppearance.YUI.Body" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_history_repair" style="@style/Widget.YUI.Button.Tonal"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/yui_control_gap"
                android:text="@string/ynotify_repair_history" />
            <TextView android:id="@+id/repair_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="@string/ynotify_not_scanned"
                android:textAppearance="@style/TextAppearance.YUI.Caption" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/yui_section_gap"
                android:text="@string/ynotify_retention" android:textAppearance="@style/TextAppearance.YUI.SectionTitle" />
            <RadioGroup android:id="@+id/retention_group" android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioButton android:id="@+id/retention_7" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_days_7" />
                <RadioButton android:id="@+id/retention_30" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_days_30" />
                <RadioButton android:id="@+id/retention_90" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_days_90" />
                <RadioButton android:id="@+id/retention_forever" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ynotify_forever" />
            </RadioGroup>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_all" style="@style/Widget.YUI.Button.Outlined"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/yui_section_gap"
                android:text="@string/ynotify_clear_all" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/yui_section_gap"
                android:text="@string/ynotify_scope_help"
                android:textAppearance="@style/TextAppearance.YUI.Body" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" />
</LinearLayout>