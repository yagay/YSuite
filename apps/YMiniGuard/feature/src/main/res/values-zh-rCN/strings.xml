    <string name="ymg_engine_scope_missing">System Engine：作用域缺少 system · 实际=%1$s</string>
    <string name="ymg_engine_current">System Engine：code %1$d · Bootstrap %2$d · gen %3$d · 跟踪 Task %4$d\n%5$s</string>
