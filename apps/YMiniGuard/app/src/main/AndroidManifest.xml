<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name="com.yagay.YMiniGuard.GuardApp"
        android:allowBackup="false"
        android:description="@string/app_description"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YMiniGuard">

        <provider
            android:name="com.yagay.YMiniGuard.EngineStatusProvider"
            android:authorities="com.yagay.YMiniGuard.engine_status"
            android:directBootAware="true"
            android:exported="true"
            android:grantUriPermissions="false" />

        <activity
            android:name="com.yagay.YMiniGuard.TargetAppsActivity"
            android:exported="false" />

        <activity
            android:name="com.yagay.YMiniGuard.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
