<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:name="com.yagay.ypower.YPowerApplication"
        android:allowBackup="true"
        android:description="@string/module_description"
        android:icon="@drawable/ic_ypower"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.YPower">
        <activity
            android:name="com.yagay.ypower.ui.MainActivity"
            android:exported="true"
            tools:replace="android:exported" />

        <activity-alias
            android:name="com.yagay.ypower.LauncherAlias"
            android:enabled="true"
            android:exported="true"
            android:targetActivity="com.yagay.ypower.ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
