<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application>
        <service
            android:name=".YNotifyNotificationListenerService"
            android:label="@string/ynotify_runtime_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".YNotifyAccessibilityService"
            android:label="@string/ynotify_runtime_accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/ynotify_accessibility_service_config" />
        </service>
        <receiver
            android:name=".YNotifyHookReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.yagay.ysuite.YNOTIFY_XPOSED_EVENT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
