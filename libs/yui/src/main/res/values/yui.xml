<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="yui_loading">Loading…</string>
    <string name="yui_search">Search</string>
    <string name="yui_open">Open</string>
    <string name="yui_status_pair">%1$s · %2$s</string>
    <string name="yui_page_counter">%1$d/%2$d</string>
    <string name="yui_placeholder">…</string>
    <string name="yui_catalog_title">YUI component catalog</string>
    <string name="yui_catalog_subtitle">Shared YSuite design-system preview</string>
    <string name="yui_catalog_actions">Actions</string>
    <string name="yui_catalog_states">States</string>
    <string name="yui_catalog_forms">Forms</string>
    <string name="yui_catalog_primary">Primary</string>
    <string name="yui_catalog_secondary">Secondary</string>
    <string name="yui_catalog_success">Success</string>
    <string name="yui_catalog_warning">Warning</string>
    <string name="yui_catalog_error">Error</string>
    <string name="yui_catalog_field">Field</string>
    <string name="yui_catalog_option_a">Option A</string>
    <string name="yui_catalog_option_b">Option B</string>

    <style name="Theme.YUI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/yui_primary</item>
        <item name="colorOnPrimary">@color/yui_on_primary</item>
        <item name="colorPrimaryContainer">@color/yui_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/yui_on_primary_container</item>
        <item name="colorSecondary">@color/yui_secondary</item>
        <item name="colorOnSecondary">@color/yui_on_secondary</item>
        <item name="colorSurface">@color/yui_surface</item>
        <item name="colorOnSurface">@color/yui_on_surface</item>
        <item name="colorSurfaceVariant">@color/yui_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/yui_on_surface_variant</item>
        <item name="colorOutline">@color/yui_outline</item>
        <item name="colorError">@color/yui_error</item>
        <item name="colorSecondaryContainer">@color/yui_palette_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/yui_palette_on_secondary_container</item>
        <item name="colorTertiary">@color/yui_palette_tertiary</item>
        <item name="colorOnTertiary">@color/yui_palette_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/yui_palette_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/yui_palette_on_tertiary_container</item>
        <item name="colorOutlineVariant">@color/yui_palette_outline_variant</item>
        <item name="colorOnError">@color/yui_palette_on_error</item>
        <item name="colorErrorContainer">@color/yui_palette_error_container</item>
        <item name="colorOnErrorContainer">@color/yui_palette_on_error_container</item>
        <item name="colorSurfaceDim">@color/yui_palette_surface_dim</item>
        <item name="colorSurfaceBright">@color/yui_palette_surface_bright</item>
        <item name="colorSurfaceContainerLowest">@color/yui_palette_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/yui_palette_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/yui_palette_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/yui_palette_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/yui_palette_surface_container_highest</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:navigationBarDividerColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="materialCardViewStyle">@style/Widget.YUI.Card</item>
        <item name="materialButtonStyle">@style/Widget.YUI.Button</item>
    </style>

    <style name="Widget.YUI.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/yui_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.YUI.Card.Emphasis" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/yui_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
    </style>

    <style name="Widget.YUI.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/yui_button_radius</item>
        <item name="android:minHeight">@dimen/yui_button_height</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.YUI.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/yui_button_radius</item>
        <item name="android:minHeight">@dimen/yui_button_height</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.YUI.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/yui_button_radius</item>
        <item name="android:minHeight">@dimen/yui_button_height</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.YUI.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/yui_card_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/yui_card_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/yui_card_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/yui_card_radius</item>
    </style>

    <style name="TextAppearance.YUI.PageTitle" parent="TextAppearance.Material3.TitleLarge" />
    <style name="TextAppearance.YUI.SectionTitle" parent="TextAppearance.Material3.TitleMedium" />
    <style name="TextAppearance.YUI.ItemTitle" parent="TextAppearance.Material3.BodyLarge" />
    <style name="TextAppearance.YUI.Body" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.YUI.Body.Strong" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.YUI.Caption" parent="TextAppearance.Material3.BodySmall" />
    <style name="TextAppearance.YUI.Label" parent="TextAppearance.Material3.LabelLarge" />
</resources>
