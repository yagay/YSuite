<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="${standaloneNfcRequired}"
        tools:replace="android:required" />

    <application
        android:name="com.yagay.ysuite.standalone.StandaloneApplication"
        android:allowBackup="${standaloneAllowBackup}"
        android:description="@string/standalone_app_description"
        android:icon="${standaloneIcon}"
        android:label="@string/standalone_app_name"
        android:localeConfig="${standaloneLocaleConfig}"
        android:roundIcon="${standaloneRoundIcon}"
        android:supportsRtl="true"
        android:theme="${standaloneTheme}"
        android:usesCleartextTraffic="${standaloneUsesCleartextTraffic}">
        <meta-data
            android:name="com.yagay.ysuite.standalone.FEATURE_ID"
            android:value="${standaloneFeatureId}" />
        <meta-data
            android:name="com.yagay.ysuite.standalone.ENTRY_ACTIVITY"
            android:value="${standaloneEntryActivity}" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/suite_file_paths" />
        </provider>

        <activity
            android:name="com.yagay.ysuite.standalone.StandaloneLauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
